{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/logo1.png",
      "dest": "/logo1.png"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}